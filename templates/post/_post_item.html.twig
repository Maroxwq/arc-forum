<div class="d-flex mb-3 gap-3 post-header align-items-start">
    <div><twig:Avatar :user="post.owner"/></div>
    <div class="flex-grow-1">
        <h3 class="post-title fw-bold m-0">{{ post.title }}</h3>
        <div class="small text-secondary">by {{ post.owner.email }}</div>
    </div>

    <div class="flex-shrink-0 vstack align-items-end">
        <div class="small text-secondary">{{ post.updatedAt|date('M j, Y H:i') }}</div>
        <div class="item-actions mt-2 u-transition">
            {% if app.user and app.user.id == post.owner.id %}
                <div class="dropdown">
                    <button class="btn btn-sm border-0 p-0 fs-5" type="button" data-bs-toggle="dropdown">⋯</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        {% if comments|length <= 3 %}
                            <li><a class="dropdown-item" href="{{ path('app_post_edit', {id: post.id}) }}"><i class="bi bi-pencil me-2"></i>Edit</a></li>
                        {% endif %}
                        <li>
                            <form action="{{ path('app_post_delete', {id: post.id}) }}" method="post" onsubmit="return confirm('Delete post?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_post' ~ post.id) }}">
                                <button type="submit" class="dropdown-item"><i class="bi bi-trash me-2"></i>Delete</button>
                            </form>
                        </li>
                    </ul>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<div class="mb-4 small text-break">{{ post.content|nl2br }}</div>
<hr class="my-3">
