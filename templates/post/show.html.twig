{% extends 'layout/two_columns.html.twig' %}

{% block title %}{{ post.title }}{% endblock %}
{% block col_order %}order-1{% endblock %}

{% block sidebar %}
    <div class="p-3">
        {% if app.user %}
            <a href="#comment-form" class="btn btn-primary w-100 reply-btn"><i class="bi bi-reply-fill"></i> Reply</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="btn btn-outline-primary reply-btn w-100"><i class="bi bi-box-arrow-in-right"></i> Sign In to reply</a>
        {% endif %}
    </div>
{% endblock %}

{% block content %}
    <div class="d-flex justify-content-between align-items-start mb-3 post-header">
        <div class="me-3 flex-grow-1 min-w-0">
            <div class="d-flex align-items-start">
                <div class="me-3"><div class="avatar bg-secondary d-inline-flex align-items-center justify-content-center text-white fw-bold">{{ post.owner.email|first|upper }}</div></div>
                <div>
                    <h1 class="post-title fw-bold m-0">{{ post.title }}</h1>
                    <div class="small text-muted">by {{ post.owner.email }}</div>
                </div>
            </div>
        </div>

        <div class="flex-shrink-0 d-flex flex-column align-items-end">
            <div class="small text-muted">{{ post.updatedAt|date('M j, Y H:i') }}</div>
            <div class="item-actions d-flex mt-2">
                {% if app.user and app.user.id == post.owner.id %}
                    {% if comments|length <= 3 %}
                        <a href="{{ path('app_post_edit', {id: post.id}) }}" class="btn btn-sm btn-primary me-2" title="Edit" aria-label="Edit"><i class="bi bi-pencil"></i></a>
                    {% endif %}
                    <form action="{{ path('app_post_delete', {id: post.id}) }}" method="post" style="display:inline" onsubmit="return confirm('Delete post?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_post' ~ post.id) }}">
                        <button type="submit" class="btn btn-sm btn-danger" title="Delete" aria-label="Delete"><i class="bi bi-trash"></i></button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="mb-4">{{ post.content|nl2br }}</div>
    <hr class="my-3">
    <div class="d-grid gap-2">{% include 'comment/list.html.twig' with { comments: comments } %}</div>

    {% if app.user %}
        <div id="comment-form" class="mt-4">
            {{ form_start(commentForm, { action: path('app_post_comment_new', {id: post.id}), method: 'POST' }) }}
            {% for msg in app.flashes('error') %}<div class="alert alert-danger small py-1 px-2">{{ msg }}</div>{% endfor %}
            {{ form_widget(commentForm.content, {attr: {class: 'form-control', rows: 3, placeholder: 'Your comment'}}) }}
            {{ form_errors(commentForm.content) }}
            <div class="mt-2 text-end"><button class="btn btn-primary reply-btn" type="submit"><i class="bi bi-reply-fill"></i> Reply</button></div>
            {{ form_end(commentForm) }}
        </div>
    {% endif %}
{% endblock %}

