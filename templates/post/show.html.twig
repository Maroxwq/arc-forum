{% extends 'layout/two_columns.html.twig' %}

{% block title %}{{ post.title }}{% endblock %}
{% block col_order %}order-1{% endblock %}

{% block sidebar %}
    <div class="p-3">
        {% if app.user %}
            <a href="#comment-form" class="btn btn-primary w-100"><i class="bi bi-reply-fill me-1"></i>Reply</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="btn btn-outline-primary w-100"><i class="bi bi-box-arrow-in-right me-1"></i>Sign In to reply</a>
        {% endif %}
    </div>
{% endblock %}

{% block content %}
    <div class="d-flex mb-3 gap-3 post-header align-items-start">
        <div class="me-3"><div class="avatar bg-secondary text-white fw-bold">{{ post.owner.email|first|upper }}</div></div>
        <div class="flex-grow-1">
            <h3 class="post-title fw-bold m-0">{{ post.title }}</h3>
            <div class="small text-muted">by {{ post.owner.email }}</div>
        </div>

        <div class="flex-shrink-0 d-flex flex-column align-items-end">
            <div class="small text-muted">{{ post.updatedAt|date('M j, Y H:i') }}</div>
            <div class="item-actions mt-2 u-transition">
                {% if app.user and app.user.id == post.owner.id %}
                    <div class="dropdown">
                        <button class="btn btn-sm border-0 p-0 fs-5 btn-dropdown-plain" type="button" data-bs-toggle="dropdown">⋯</button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            {% if comments|length <= 3 %}
                                <li><a class="dropdown-item" href="{{ path('app_post_edit', {id: post.id}) }}"><i class="bi bi-pencil me-2"></i>Edit</a></li>
                            {% endif %}
                            <li>
                                <form action="{{ path('app_post_delete', {id: post.id}) }}" method="post" onsubmit="return confirm('Delete post?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_post' ~ post.id) }}">
                                    <button type="submit" class="dropdown-item"><i class="bi bi-trash me-2"></i>Delete</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="mb-4 small text-break">{{ post.content|nl2br }}</div>
    <hr class="my-3">
    {% include 'comment/list.html.twig' with { comments: comments } %}

    {% if app.user %}
        <div id="comment-form" class="mt-4">
            {{ form_start(commentForm, { action: path('app_post_comment_new', {id: post.id}), method: 'POST' }) }}
            {% for msg in app.flashes('error') %}<div class="alert alert-danger small py-1 px-2">{{ msg }}</div>{% endfor %}
            {{ form_widget(commentForm.content, {attr: {class: 'form-control', rows: 3, placeholder: 'Your comment'}}) }}
            {{ form_errors(commentForm.content) }}
            <div class="mt-2 text-end"><button class="btn btn-primary reply-btn" type="submit"><i class="bi bi-reply-fill me-1"></i>Reply</button></div>
            {{ form_end(commentForm) }}
        </div>
    {% endif %}
{% endblock %}
