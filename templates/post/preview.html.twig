<div class="post-card stretched-item" role="article" aria-labelledby="post-{{ post.id }}-title">
    <div class="post-meta">
        <div class="avatar" aria-hidden="true">{{ post.owner.email|first|upper }}</div>
        <div class="min-w-0">
            <h3 class="post-title h5 m-0"><a id="post-{{ post.id }}-title" href="{{ path('app_post_show', { id: post.id }) }}" class="text-decoration-none text-body">{{ post.title }}</a></h3>
            <a href="{{ path('app_post_show', { id: post.id }) }}" class="stretched-link" aria-label="Open post {{ post.title }}"></a>
            <div class="small text-muted">{{ post.updatedAt|date('M j, Y') }} · by {{ post.owner.email }}</div>
            <div class="post-excerpt">{{ post.content|striptags|trim|slice(0, 100) }}{% if post.content|length > 200 %}…{% endif %}</div>
        </div>
    </div>

    <div class="text-end d-flex flex-column align-items-end">
        <span class="badge bg-primary mb-2"><i class="bi bi-chat-dots-fill"></i> {{ commentsCount }}</span>
            <div class="item-actions">
                {% if app.user and app.user.id == post.owner.id %}
                    <a href="{{ path('app_post_edit', {id: post.id}) }}" class="btn btn-sm btn-link px-1" title="Edit" aria-label="Edit"><i class="bi bi-pencil-square"></i></a>
                    <form action="{{ path('app_post_delete', {id: post.id}) }}" method="post" style="display:inline" onsubmit="return confirm('Delete post?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_post' ~ post.id) }}">
                        <button type="submit" class="btn btn-sm btn-link px-1" title="Delete" aria-label="Delete"><i class="bi bi-trash-fill"></i></button>
                    </form>
                {% endif %}
            </div>
    </div>
</div>
