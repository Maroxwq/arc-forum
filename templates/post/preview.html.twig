<div class="position-relative">
    <div class="post-meta d-flex align-items-start gap-3">
        <div class="avatar bg-secondary text-white fw-bold">{{ post.owner.email|first|upper }}</div>
        <div class="min-w-0">
            <h3 class="post-title h5 m-0"><a id="post-{{ post.id }}-title" href="{{ path('app_post_show', { id: post.id }) }}" class="text-decoration-none text-body d-block">{{ post.title }}</a></h3>
            <a href="{{ path('app_post_show', { id: post.id }) }}" class="stretched-link"></a>
            <div class="small text-muted">{{ post.updatedAt|date('M j, Y') }} · by {{ post.owner.email }}</div>
            <div class="mt-1 small text-muted">{{ post.content|striptags|trim|slice(0, 100) }}{% if post.content|length > 100 %}…{% endif %}</div>
        </div>

        <div class="text-end d-flex flex-column align-items-end">
            <span class="badge bg-primary mb-2"><i class="bi bi-chat-dots-fill me-1"></i>{{ commentsCount }}</span>
            <div class="item-actions u-transition">
                {% if app.user and app.user.id == post.owner.id %}
                    <div class="dropdown">
                        <button class="btn btn-sm border-0 p-0 fs-5 btn-dropdown-plain" type="button" data-bs-toggle="dropdown">⋯</button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="{{ path('app_post_edit', {id: post.id}) }}"><i class="bi bi-pencil-square me-2"></i>Edit</a></li>
                            <li>
                                <form action="{{ path('app_post_delete', {id: post.id}) }}" method="post" onsubmit="return confirm('Delete post?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_post' ~ post.id) }}">
                                    <button type="submit" class="dropdown-item"><i class="bi bi-trash-fill me-2"></i>Delete</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
