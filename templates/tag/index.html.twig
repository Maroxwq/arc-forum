{% extends 'layout/two_columns.html.twig' %}

{% block title %}All Posts{% endblock %}

{% block content %}
    <div class="post-list">
        {% for item in items %}
            {% set post = item.post %}
            {% include('post/_post_list_item.html.twig') %}
        {% else %}
            <div class="text-center text-secondary">No posts yet.</div>
        {% endfor %}
    </div>
{% endblock %}
