{% extends 'layout/two_columns.html.twig' %}

{% block title %}All Posts{% endblock %}

{% block content %}
    <div class="post-list">
        {% for item in items %}
            {% set post = item.post %}
            {{ include('post/preview.html.twig', { post: post, commentsCount: item.commentsCount }) }}
        {% else %}
            <div class="text-center text-muted">No posts yet.</div>
        {% endfor %}
    </div>
{% endblock %}
