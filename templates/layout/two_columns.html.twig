{% extends 'layout/main.html.twig' %}

{% block main %}
    <div class="container">
        <div class="row">
            <div class="col-3 {% block col_order %}{% endblock %}">
                <aside class="sticky-top sidebar">
                    {% block sidebar %}
                        {% include 'layout/_sidebar.html.twig' %}
                    {% endblock %}
                </aside>
            </div>
            <div class="col-9">
                {% block content %}{% endblock %}
            </div>
        </div>
    </div>
{% endblock %}
