{% extends 'base.html.twig' %}

{% block body %}
    <header class="navbar navbar-expand-lg border-bottom fixed-top bg-body-tertiary">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_tag_all') }}">ARC Forum</a>
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-2">
                {% if app.user %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="userDropdown" data-bs-toggle="dropdown">{{ app.user.userIdentifier }}</a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item text-muted" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-in-left me-2"></i>Log out</a></li>
                        </ul>
                    </li>
                {% else %}
                    <li class="nav-item"><a class="btn btn-outline-primary btn-sm" href="{{ path('app_register') }}"><i class="bi bi-person-plus me-1"></i>Sign Up</a></li>
                    <li class="nav-item"><a class="btn btn-primary btn-sm" href="{{ path('app_login') }}"><i class="bi bi-box-arrow-in-right me-1"></i>Sign In</a></li>
                {% endif %}
            </ul>
        </div>
    </header>

    <main class="flex-grow-1 site-main">
        {% block main %}{% endblock %}
    </main>

    <footer class="py-3 text-center">© ARC Forum 2025.</footer>
{% endblock %}
