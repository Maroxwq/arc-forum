<li class="list-group-item py-2 comment-item">
    <div class="d-flex justify-content-between align-items-start">
        <div class="d-flex gap-3 align-items-start">
            <div class="avatar comment-avatar" aria-hidden="true">{{ comment.owner.email|first|upper }}</div>
            <div>
                <strong>{{ comment.owner.email }}</strong>
                <div class="small text-muted">{{ comment.updatedAt|date('M j, Y H:i') }}</div>
                <div class="mt-1 small">{{ comment.content|nl2br }}</div>
            </div>
        </div>
        <div class="item-actions">
            {% if app.user and comment.owner.id == app.user.id %}
                <div class="d-flex align-items-center flex-nowrap">
                    <a href="{{ path('app_post_comment_edit', {id: comment.id}) }}" class="btn btn-link btn-sm p-0 me-2">Edit</a>
                    <form action="{{ path('app_post_comment_delete', {id: comment.id}) }}" method="post" class="d-flex align-items-center m-0 p-0" onsubmit="return confirm('Delete this comment?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                        <button type="submit" class="btn btn-link btn-sm text-danger p-0 mb-0">Delete</button>
                    </form>
                </div>
            {% endif %}
        </div>
    </div>
</li>
