<article class="comment-item" id="comment-{{ comment.id }}" aria-labelledby="comment-{{ comment.id }}-author">
    <div class="d-flex gap-3">
        <div class="avatar comment-avatar" aria-hidden="true">{{ comment.owner.email|first|upper }}</div>
        <div class="flex-grow-1 min-w-0">
            <div>
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <strong id="comment-{{ comment.id }}-author">{{ comment.owner.email }}</strong>
                        <div class="small text-muted">{{ comment.updatedAt|date('M j, Y H:i') }}</div>
                    </div>
                </div>
                <div class="mt-2 small" role="article">{{ comment.content|nl2br }}</div>
            </div>
        </div>

        <div class="item-actions">
            {% if app.user and comment.owner.id == app.user.id %}
                <a href="{{ path('app_post_comment_edit', {id: comment.id}) }}" class="btn btn-sm btn-link px-1" title="Edit comment" aria-label="Edit comment"><i class="bi bi-pencil-square"></i></a>
                <form action="{{ path('app_post_comment_delete', {id: comment.id}) }}" method="post" style="display:inline" onsubmit="return confirm('Delete this comment?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                    <button type="submit" class="btn btn-sm btn-link px-1" title="Delete comment" aria-label="Delete comment"><i class="bi bi-trash-fill"></i></button>
                </form>
            {% endif %}
        </div>
    </div>
</article>
