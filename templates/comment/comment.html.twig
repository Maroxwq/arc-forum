<article class="comment-item d-flex align-items-start" id="comment-{{ comment.id }}">
    <div class="me-3"><div class="avatar bg-secondary text-white fw-bold">{{ comment.owner.email|first|upper }}</div></div>
    <div class="flex-grow-1">
        <div class="d-flex justify-content-between align-items-start">
            <div class="fw-semibold">{{ comment.owner.email }}</div>
            <div class="small text-muted">{{ comment.updatedAt|date('M j, Y H:i') }}</div>
        </div>

        <div class="mt-2 small">{{ comment.content|nl2br }}</div>

        <div class="mt-2 d-flex justify-content-end">
            <div class="item-actions u-transition">
                {% if app.user and comment.owner.id == app.user.id %}
                    <div class="dropdown">
                        <button class="btn border-0 p-0 fs-5 btn-dropdown-plain" type="button" data-bs-toggle="dropdown">⋯</button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="{{ path('app_post_comment_edit', {id: comment.id}) }}"><i class="bi bi-pencil-square me-2"></i>Edit</a></li>
                            <li>
                                <form action="{{ path('app_post_comment_delete', {id: comment.id}) }}" method="post" onsubmit="return confirm('Delete this comment?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                                    <button type="submit" class="dropdown-item"><i class="bi bi-trash-fill me-2"></i>Delete</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</article>
